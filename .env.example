# Variáveis de ambiente — Hospital Price Automation
# Copie para .env e preencha. NUNCA commit o .env.

# === SQL Server ===
SQL_SERVER_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=

# === Caminhos de arquivos ===
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# === Logs ===
LOG_LEVEL=INFO
LOG_DIR=logs
