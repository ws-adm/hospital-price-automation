__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenv
venv/
env/
.venv/

# Segredos e ambiente
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp
